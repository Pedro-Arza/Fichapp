-- Crear base de datos
DROP DATABASE IF EXISTS fichapp;
CREATE DATABASE fichapp;
USE fichapp;

USE fichapp;

-- =====================================================
-- TABLA: Departamentos
-- =====================================================
CREATE TABLE Departamentos (
    id CHAR(36) PRIMARY KEY DEFAULT (UUID()),
    nombre VARCHAR(100) NOT NULL,
    descripcion TEXT,
    responsable_id CHAR(36) NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    INDEX idx_nombre (nombre)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- =====================================================
-- TABLA: Turnos
-- =====================================================
CREATE TABLE Turnos (
    id CHAR(36) PRIMARY KEY DEFAULT (UUID()),
    nombre VARCHAR(100) NOT NULL,
    hora_inicio TIME NOT NULL,
    hora_fin TIME NOT NULL,
    horas_esperadas DECIMAL(5,2) NOT NULL,
    dias_semana JSON COMMENT 'Array de días: ["lunes", "martes", ...]',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    INDEX idx_nombre (nombre)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- =====================================================
-- TABLA: Empleados
-- =====================================================
CREATE TABLE Empleados (
    id CHAR(36) PRIMARY KEY DEFAULT (UUID()),
    nombre_completo VARCHAR(255) NOT NULL,
    email VARCHAR(255) NOT NULL UNIQUE,
    password_hash VARCHAR(255) NOT NULL,
    foto_url TEXT,
    departamento_id CHAR(36),
    turno_id CHAR(36),
    rol VARCHAR(100),
    fecha_ingreso DATE NOT NULL,
    estado ENUM('activo', 'inactivo', 'suspendido') DEFAULT 'activo',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    
    FOREIGN KEY (departamento_id) REFERENCES Departamentos(id) ON DELETE SET NULL,
    FOREIGN KEY (turno_id) REFERENCES Turnos(id) ON DELETE SET NULL,
    
    INDEX idx_email (email),
    INDEX idx_estado (estado),
    INDEX idx_departamento (departamento_id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Agregar foreign key de responsable después de crear Empleados
ALTER TABLE Departamentos 
ADD FOREIGN KEY (responsable_id) REFERENCES Empleados(id) ON DELETE SET NULL;

-- =====================================================
-- TABLA: Fichajes
-- =====================================================
CREATE TABLE Fichajes (
    id CHAR(36) PRIMARY KEY DEFAULT (UUID()),
    empleado_id CHAR(36) NOT NULL,
    tipo ENUM(
        'entrada', 
        'salida_comida', 
        'vuelta_comida', 
        'inicio_descanso', 
        'fin_descanso', 
        'salida'
    ) NOT NULL,
    fecha_hora DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    ubicacion VARCHAR(255) COMMENT 'Coordenadas GPS o nombre del lugar',
    notas TEXT,
    ip_address VARCHAR(45),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    
    FOREIGN KEY (empleado_id) REFERENCES Empleados(id) ON DELETE CASCADE,
    
    INDEX idx_empleado_fecha (empleado_id, fecha_hora),
    INDEX idx_tipo (tipo),
    INDEX idx_fecha (fecha_hora)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- =====================================================
-- TABLA: Ausencias
-- =====================================================
CREATE TABLE Ausencias (
    id CHAR(36) PRIMARY KEY DEFAULT (UUID()),
    empleado_id CHAR(36) NOT NULL,
    tipo ENUM(
        'vacaciones',
        'baja_medica',
        'permiso',
        'ausencia_justificada',
        'ausencia_injustificada',
        'teletrabajo'
    ) NOT NULL,
    fecha_inicio DATE NOT NULL,
    fecha_fin DATE NOT NULL,
    motivo TEXT,
    estado ENUM('pendiente', 'aprobada', 'rechazada') DEFAULT 'pendiente',
    aprobado_por CHAR(36) NULL,
    fecha_aprobacion DATETIME NULL,
    notas_aprobacion TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    
    FOREIGN KEY (empleado_id) REFERENCES Empleados(id) ON DELETE CASCADE,
    FOREIGN KEY (aprobado_por) REFERENCES Empleados(id) ON DELETE SET NULL,
    
    INDEX idx_empleado_fechas (empleado_id, fecha_inicio, fecha_fin),
    INDEX idx_estado (estado),
    INDEX idx_tipo (tipo)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- =====================================================
-- VISTA: Resumen de horas trabajadas por día
-- =====================================================
CREATE OR REPLACE VIEW Vista_Horas_Diarias AS
SELECT 
    e.id as empleado_id,
    e.nombre_completo,
    DATE(f.fecha_hora) as fecha,
    COUNT(*) as total_fichajes,
    MIN(CASE WHEN f.tipo = 'entrada' THEN f.fecha_hora END) as primera_entrada,
    MAX(CASE WHEN f.tipo = 'salida' THEN f.fecha_hora END) as ultima_salida
FROM Empleados e
LEFT JOIN Fichajes f ON e.id = f.empleado_id
GROUP BY e.id, e.nombre_completo, DATE(f.fecha_hora);

