-- =====================================================
-- PROCEDIMIENTOS ALMACENADOS ÚTILES
-- =====================================================

-- Calcular horas trabajadas en un día para un empleado
DELIMITER //
CREATE PROCEDURE Calcular_Horas_Dia(
    IN p_empleado_id CHAR(36),
    IN p_fecha DATE,
    OUT p_horas DECIMAL(5,2)
)
BEGIN
    DECLARE v_entrada DATETIME;
    DECLARE v_salida DATETIME;
    DECLARE v_tiempo_comida INT DEFAULT 0;
    DECLARE v_tiempo_descansos INT DEFAULT 0;
    
    -- Primera entrada del día
    SELECT MIN(fecha_hora) INTO v_entrada
    FROM Fichajes
    WHERE empleado_id = p_empleado_id 
    AND DATE(fecha_hora) = p_fecha
    AND tipo = 'entrada';
    
    -- Última salida del día
    SELECT MAX(fecha_hora) INTO v_salida
    FROM Fichajes
    WHERE empleado_id = p_empleado_id 
    AND DATE(fecha_hora) = p_fecha
    AND tipo = 'salida';
    
    -- Calcular tiempo de comida
    SELECT COALESCE(SUM(TIMESTAMPDIFF(MINUTE, 
        (SELECT fecha_hora FROM Fichajes f2 
         WHERE f2.empleado_id = p_empleado_id 
         AND f2.tipo = 'salida_comida' 
         AND DATE(f2.fecha_hora) = p_fecha 
         AND f2.fecha_hora < f1.fecha_hora 
         ORDER BY f2.fecha_hora DESC LIMIT 1),
        f1.fecha_hora
    )), 0) INTO v_tiempo_comida
    FROM Fichajes f1
    WHERE f1.empleado_id = p_empleado_id 
    AND f1.tipo = 'vuelta_comida'
    AND DATE(f1.fecha_hora) = p_fecha;
    
    -- Calcular horas
    IF v_entrada IS NOT NULL AND v_salida IS NOT NULL THEN
        SET p_horas = (TIMESTAMPDIFF(MINUTE, v_entrada, v_salida) - v_tiempo_comida - v_tiempo_descansos) / 60.0;
    ELSE
        SET p_horas = 0;
    END IF;
END//
DELIMITER ;
